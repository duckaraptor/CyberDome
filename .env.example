# Settings for the CyberDome Web UI.
  # Copy this file to .env and fill in the values. .env is git-ignored, so never commit real values.
  # Empty required values stop the Web UI at startup with a message that names them.

  # Keycloak server and the confidential client the Web UI logs in with
  KEYCLOAK_SERVER_URL=http://localhost:8080/auth
  KEYCLOAK_REALM=myrealm
  KEYCLOAK_CLIENT_ID=ZeroTrustPlatform
  # Required. Must match the ZeroTrustPlatform client's secret in Keycloak.
  # For the local stack, it's the "secret" of that client in infra/keycloak/myrealm-realm.json.
  KEYCLOAK_CLIENT_SECRET=

  # Keycloak admin login, used to read users, roles and login events
  KEYCLOAK_ADMIN_USERNAME=admin
  # Required. For the local stack, see KC_BOOTSTRAP_ADMIN_PASSWORD in compose.yml.
  KEYCLOAK_ADMIN_PASSWORD=
  # Leave empty: admin-cli is a public client
  KEYCLOAK_ADMIN_CLIENT_SECRET=

  # Required. Flask signs the session cookie with this. Generate one with:
  #   python3 -c "import secrets; print(secrets.token_hex(32))"
  FLASK_SECRET_KEY=

  # Optional: Gmail account and app password that email secret shares to PAM approvers.
  # Without them, the Web UI skips the email and prints a message.
  PAM_EMAIL_SENDER=
  PAM_EMAIL_PASSWORD=